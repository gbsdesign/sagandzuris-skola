<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="ring" android:innerRadiusRatio="2.5" android:thickness="4dp" android:useLevel="false">
            <solid android:color="#1F7A4C94" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate android:fromDegrees="270" android:toDegrees="270" android:pivotX="50%" android:pivotY="50%">
            <shape android:shape="ring" android:innerRadiusRatio="2.5" android:thickness="4dp" android:useLevel="true">
                <solid android:color="#7A4C94" />
            </shape>
        </rotate>
    </item>
</layer-list>
