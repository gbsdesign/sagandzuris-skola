<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/row" android:layout_width="match_parent" android:layout_height="48dp"
    android:gravity="center_vertical" android:orientation="horizontal">
    <FrameLayout android:layout_width="34dp" android:layout_height="34dp">
        <ImageView android:id="@+id/dot" android:layout_width="match_parent" android:layout_height="match_parent"
            android:importantForAccessibility="no" android:scaleType="fitXY" />
        <ImageView android:id="@+id/icon" android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>
    <TextView android:id="@+id/label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp"
        android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/ink" android:textSize="15sp" />
    <TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:textColor="@color/muted" android:textSize="13sp" />
</LinearLayout>
