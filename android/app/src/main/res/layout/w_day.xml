<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_bg" android:orientation="vertical" android:padding="14dp">
    <TextView android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="29 ოქტომბერი" android:textColor="@color/wine" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/weekday" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="2" android:text="ხუთშაბათი" android:textColor="@color/muted" android:textSize="12sp" />
    <TextView android:id="@+id/saints" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="6dp"
        android:layout_weight="1" android:ellipsize="end" android:lineSpacingExtra="2dp" android:text="დღის წმიდანები"
        android:textColor="@color/ink" android:textSize="13sp" />
</LinearLayout>
