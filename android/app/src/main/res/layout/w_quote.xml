<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_bg" android:gravity="center_vertical" android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/quote" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end"
        android:fontFamily="serif" android:lineSpacingExtra="3dp" android:maxLines="6" android:text="„დღის სიტყვა“"
        android:textColor="@color/ink" android:textSize="15sp" />
    <TextView android:id="@+id/author" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:gravity="end" android:textColor="@color/wine" android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
