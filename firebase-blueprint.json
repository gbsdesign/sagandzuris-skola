{
  "entities": {
    "Setting": {
      "title": "Setting",
      "description": "App settings including logo data",
      "type": "object",
      "properties": {
        "logoUrl": {
          "type": "string",
          "description": "Base64 or URL of the school logo"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when logo was saved"
        }
      }
    },
    "Student": {
      "title": "Student",
      "description": "Student profile data and schedule",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth user ID" },
        "email": { "type": "string", "description": "Student email" },
        "displayName": { "type": "string", "description": "Google display name" },
        "photoURL": { "type": "string", "description": "Avatar URL" },
        "firstName": { "type": "string", "description": "Student first name" },
        "lastName": { "type": "string", "description": "Student last name" },
        "birthDate": { "type": "object", "description": "Date of birth" },
        "region": { "type": "string", "description": "Region" },
        "city": { "type": "string", "description": "City or village" },
        "experienceLevel": { "type": "string", "description": "Level or status" },
        "voices": { "type": "array", "description": "Selected voices" },
        "workSchedule": { "type": "object", "description": "Selected hours per day" },
        "completedSessions": { "type": "object", "description": "Real weekly completed sessions map" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" },
        "lastActiveAt": { "type": "string", "description": "ISO timestamp" }
      }
    },
    "User": {
      "title": "User",
      "description": "General user data",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "User email" },
        "displayName": { "type": "string", "description": "Display name" }
      }
    },
    "Admin": {
      "title": "Admin",
      "description": "Administrator permission record",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "Admin email address" },
        "addedBy": { "type": "string", "description": "Email of admin who granted rights" },
        "role": { "type": "string", "description": "Admin role, e.g. superadmin or admin" },
        "addedAt": { "type": "string", "description": "ISO timestamp of assignment" }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/settings/logo": {
      "schema": "Setting",
      "description": "Stores the school logo"
    },
    "/students/{userId}": {
      "schema": "Student",
      "description": "Stores student profile, weekly schedule, and completion progress"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user data"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Stores administrator records"
    }
  }
}
