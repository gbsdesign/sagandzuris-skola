rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- Who is asking -------------------------------------------------------------------------
    // Roles (src/context/AuthContext.tsx mirrors them):
    //   owner       — the founder's address below: everything; only they name superadmins
    //   superadmin  — admins/{email}.role == 'superadmin': everything, names admins
    //   admin       — role 'admin' (or an old document without a role): the whole school, names teachers
    //   teacher     — role 'teacher': only the classes and psalter groups whose teacherIds hold them
    // Staff checks go by e-mail, so the e-mail must be verified (Google sign-in always is).
    // Members are added to classes and groups by their teacher or an admin (there are no invite links).
    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function verified() {
      return isSignedIn() && request.auth.token.email_verified == true && request.auth.token.email is string;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function isOwner() { return verified() && myEmail() == 'mr.gabunia@gmail.com'; }
    function staffPath() { return /databases/$(database)/documents/admins/$(myEmail()); }
    function staffRole() {
      return (verified() && exists(staffPath())) ? get(staffPath()).data.get('role', 'admin') : '';
    }
    function isSuperAdmin() { return isOwner() || staffRole() == 'superadmin'; }
    function isAdmin() { return isSuperAdmin() || staffRole() == 'admin'; }
    function isTeacher() { return isAdmin() || staffRole() == 'teacher'; }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function changed() { return incoming().diff(existing()).affectedKeys(); }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Public school settings: logo, recordings bound from the admin panel, which sections are open.
    // „placements“ (recordings moved to another region, song or album) is for the owner and superadmins only.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if (settingId == 'placements' && isSuperAdmin()) || (settingId != 'placements' && isAdmin());
    }

    // ---- Staff -----------------------------------------------------------------------------------
    match /admins/{email} {
      function canGrant(role) {
        return (role == 'superadmin' && isOwner())
          || (role == 'admin' && isSuperAdmin())
          || (role == 'teacher' && isAdmin());
      }
      // the list is for admins; everyone may read their own document (to learn their role)
      allow read: if isAdmin() || (verified() && myEmail() == email);
      allow create: if canGrant(incoming().get('role', '')) && incoming().email == email;
      allow update: if canGrant(incoming().get('role', '')) && canGrant(existing().get('role', 'admin'));
      allow delete: if canGrant(existing().get('role', 'admin')) && email != 'mr.gabunia@gmail.com';
    }

    // ---- Students --------------------------------------------------------------------------------
    match /students/{userId} {
      function isSelf() { return isSignedIn() && uid() == userId; }
      // a teacher of one of this student's classes (classes copy their teachers into teacherIds)
      function teachesMe() { return isTeacher() && uid() in resource.data.get('teacherIds', []); }
      // a teacher who has just added this student to their class gets access to the student's path:
      // teacherVia names that class, and only its teachers may be added
      function becomingTeacher() {
        let c = get(/databases/$(database)/documents/classes/$(incoming().teacherVia)).data;
        return isTeacher()
          && changed().hasOnly(['teacherIds', 'teacherVia'])
          && uid() in c.get('teacherIds', [])
          && userId in c.memberIds
          && uid() in incoming().teacherIds
          && incoming().teacherIds.hasAll(existing().get('teacherIds', []))
          && incoming().teacherIds.hasOnly(existing().get('teacherIds', []).concat(c.get('teacherIds', [])));
      }

      allow read: if isSelf() || isAdmin() || teachesMe();
      allow create: if isSelf() || isAdmin();
      // teachers may only arrange the student's path ("საგანძურის გზა") and switch the kids' mode
      allow update: if isSelf() || isAdmin()
        || (teachesMe() && changed().hasOnly(['selectedChantVariants', 'kidsMode', 'updatedAt']))
        || becomingTeacher();
      allow delete: if isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if (isSignedIn() && uid() == userId) || isAdmin();
      }
    }

    // ---- Admission of new members (src/utils/memberAccess.ts) ----------------------------------------------------
    // A newcomer asks once (status 'pending', nothing given) and may only count their own visits; superadmins let
    // them in with chosen features, or refuse. The request is never deleted, so a refused member stays refused.
    match /memberAccess/{userId} {
      function isSelf() { return isSignedIn() && uid() == userId; }
      allow read: if isSelf() || isSuperAdmin();
      allow create: if isSuperAdmin()
        || (isSelf()
          && incoming().keys().hasOnly(['status', 'features', 'requestedAt', 'attempts', 'lastAttemptAt'])
          && incoming().status == 'pending'
          && incoming().features == []);
      allow update: if isSuperAdmin() || (isSelf() && changed().hasOnly(['attempts', 'lastAttemptAt']));
      allow delete: if false;
    }
    // who let a member in or refused them: superadmins only, the member never reads it
    match /accessDecisions/{userId} {
      allow read, write: if isSuperAdmin();
    }

    // A person's own settings (e.g. the "დღევანდელი წირვა" draft and templates)
    match /users/{userId} {
      allow read, write: if (isSignedIn() && uid() == userId) || isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if (isSignedIn() && uid() == userId) || isAdmin();
      }
    }

    // Teacher's confirmations ("ჩათვლა") of a student's voices: the student reads, their teachers write
    match /confirmations/{userId} {
      function teachesStudent() {
        return isTeacher()
          && uid() in get(/databases/$(database)/documents/students/$(userId)).data.get('teacherIds', []);
      }
      allow read: if (isSignedIn() && uid() == userId) || isAdmin() || teachesStudent();
      allow write: if isAdmin() || teachesStudent();
    }

    // ---- Directory: name and photo of everyone signed in, so teachers can add people to their classes
    // and psalter groups without seeing anyone's private record. Each person writes only their own entry.
    match /directory/{userId} {
      allow read: if isTeacher();
      allow create, update: if isSignedIn() && uid() == userId
        && incoming().keys().hasOnly(['uid', 'name', 'firstName', 'lastName', 'churchName', 'photoURL', 'updatedAt'])
        && incoming().uid == userId;
      allow delete: if isAdmin() || (isSignedIn() && uid() == userId);
    }

    // ---- Classes -----------------------------------------------------------------------------------
    match /classes/{classId} {
      function cls() { return get(/databases/$(database)/documents/classes/$(classId)).data; }
      function teachesClass() { return isTeacher() && uid() in cls().get('teacherIds', []); }
      function inClass() {
        return isAdmin() || (isSignedIn() && (uid() in cls().memberIds || uid() in cls().get('teacherIds', [])));
      }
      // leaving: only oneself is taken out
      function leaving() {
        return isSignedIn()
          && changed().hasOnly(['memberIds', 'members', 'updatedAt'])
          && uid() in existing().memberIds
          && incoming().memberIds == existing().memberIds.removeAll([uid()])
          && incoming().members.size() == existing().members.size() - 1;
      }

      allow read: if isAdmin()
        || (isSignedIn() && (uid() in resource.data.memberIds || uid() in resource.data.teacherIds));
      allow create, delete: if isAdmin();
      // a class's teacher runs it, but only admins choose its teachers
      allow update: if isAdmin()
        || (isTeacher() && uid() in existing().get('teacherIds', []) && !changed().hasAny(['teacherIds', 'teachers']))
        || leaving();

      // Class chat: members and teachers read and post as themselves; the author or a teacher deletes
      match /messages/{messageId} {
        allow read: if inClass();
        allow create: if inClass()
          && incoming().uid == uid()
          && (incoming().teacher == false || teachesClass() || isAdmin())
          && incoming().createdAt == request.time
          && incoming().kind in ['text', 'voice']
          && incoming().text is string && incoming().text.size() <= 2000;
        allow delete: if isAdmin() || teachesClass() || (isSignedIn() && existing().uid == uid());
      }

      // A voice message's MP3, in parts below Firestore's 1 MiB document limit
      match /voice/{partId} {
        allow read: if inClass();
        allow create: if inClass()
          && incoming().uid == uid()
          && incoming().data is bytes && incoming().data.size() <= 750000;
        allow delete: if isAdmin() || teachesClass() || (isSignedIn() && existing().uid == uid());
      }

      // Teacher's assignments (chant + voice + due date) and lesson attendance
      match /assignments/{assignmentId} {
        allow read: if inClass();
        allow write: if isAdmin() || teachesClass();
      }
      match /attendance/{day} {
        allow read: if inClass();
        allow write: if isAdmin() || teachesClass();
      }
    }

    // ---- Private chats: a teacher and a student of their class ----------------------------------------
    // Teachers students can write to: name and photo only, each teacher keeps their own entry
    match /teachers/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isTeacher() && uid() == userId
        && incoming().keys().hasOnly(['name', 'photoURL', 'updatedAt'])
        && incoming().name is string && incoming().name.size() <= 120
        && incoming().photoURL is string && incoming().photoURL.size() <= 2000;
      allow delete: if isAdmin() || (isSignedIn() && uid() == userId);
    }

    // dms/{teacherUid}_{studentUid}: classId names a class the teacher teaches and the student is in.
    // Only the two of them read and write; the superadmin may read every chat, but not write in it.
    match /dms/{dmId} {
      function thread() { return get(/databases/$(database)/documents/dms/$(dmId)).data; }
      function linkedBy(teacherUid, studentUid, classId) {
        let c = get(/databases/$(database)/documents/classes/$(classId)).data;
        return teacherUid in c.get('teacherIds', []) && studentUid in c.get('memberIds', []);
      }
      // the two are still teacher and student of that class
      function stillLinked() { let t = thread(); return linkedBy(t.teacherUid, t.studentUid, t.classId); }
      function inThread() { return isSignedIn() && uid() in thread().members; }
      function isThreadTeacher() { return isSignedIn() && uid() == thread().teacherUid; }

      // a chat not made yet reads as missing (the app checks before making it)
      allow get: if isSuperAdmin() || (isSignedIn() && (resource == null || uid() in resource.data.members));
      allow list: if isSuperAdmin() || (isSignedIn() && uid() in resource.data.members);
      allow create: if isSignedIn()
        && dmId == incoming().teacherUid + '_' + incoming().studentUid
        && incoming().teacherUid != incoming().studentUid
        && incoming().members == [incoming().teacherUid, incoming().studentUid]
        && uid() in incoming().members
        && incoming().classId is string
        && linkedBy(incoming().teacherUid, incoming().studentUid, incoming().classId)
        && incoming().keys().hasOnly(['members', 'teacherUid', 'studentUid', 'classId', 'room', 'names', 'photos',
             'createdAt', 'lastAt', 'lastBy', 'lastText', 'read', 'callAt', 'callBy']);
      // each marks only their own reading; only the teacher starts a call; classId may move to another class
      // the two share
      allow update: if isSignedIn() && uid() in existing().members
        && changed().hasOnly(['classId', 'names', 'photos', 'lastAt', 'lastBy', 'lastText', 'read', 'callAt', 'callBy'])
        && linkedBy(existing().teacherUid, existing().studentUid, incoming().classId)
        && incoming().get('read', {}).diff(existing().get('read', {})).affectedKeys().hasOnly([uid()])
        && (!changed().hasAny(['lastBy']) || incoming().lastBy == uid())
        && (!changed().hasAny(['callAt', 'callBy']) || (uid() == existing().teacherUid && incoming().callBy == uid()));
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read: if isSuperAdmin() || inThread();
        allow create: if inThread() && stillLinked()
          && incoming().uid == uid()
          && incoming().teacher == isThreadTeacher()
          && incoming().createdAt == request.time
          && (incoming().kind in ['text', 'voice'] || (incoming().kind == 'call' && isThreadTeacher()))
          && incoming().text is string && incoming().text.size() <= 2000;
        allow delete: if isSuperAdmin() || (isSignedIn() && existing().uid == uid());
      }

      // A voice message's MP3, in parts below Firestore's 1 MiB document limit
      match /voice/{partId} {
        allow read: if isSuperAdmin() || inThread();
        allow create: if inThread() && stillLinked()
          && incoming().uid == uid()
          && incoming().data is bytes && incoming().data.size() <= 750000;
        allow delete: if isSuperAdmin() || (isSignedIn() && existing().uid == uid());
      }
    }

    // ---- Psalter groups ("ფსალმუნთა ჯგუფი") ---------------------------------------------------------
    match /psalterGroups/{groupId} {
      function grp() { return get(/databases/$(database)/documents/psalterGroups/$(groupId)).data; }
      function leadsGroup() { return isTeacher() && uid() in grp().get('teacherIds', []); }
      function inGroup() {
        return isAdmin() || (isSignedIn() && (uid() in grp().memberIds || uid() in grp().get('teacherIds', [])));
      }
      // leaving frees one's kathisma (it is taken out of the distribution)
      function leavingGroup() {
        return isSignedIn()
          && changed().hasOnly(['memberIds', 'members', 'assignment', 'updatedAt'])
          && uid() in existing().memberIds
          && incoming().memberIds == existing().memberIds.removeAll([uid()])
          && incoming().members.size() == existing().members.size() - 1;
      }
      // a member renames themself (their Georgian name for the commemoration list)
      function renamingSelf() {
        return isSignedIn()
          && changed().hasOnly(['members', 'updatedAt'])
          && uid() in existing().memberIds
          && incoming().members.size() == existing().members.size();
      }

      allow read: if isAdmin()
        || (isSignedIn() && (uid() in resource.data.memberIds || uid() in resource.data.teacherIds));
      allow create: if isAdmin() || (isTeacher() && uid() in incoming().teacherIds);
      allow update: if isAdmin()
        || (isTeacher() && uid() in existing().get('teacherIds', []) && !changed().hasAny(['teacherIds', 'teachers']))
        || leavingGroup() || renamingSelf();
      allow delete: if isAdmin() || (isTeacher() && uid() in existing().get('teacherIds', []));

      // One cycle (1 or 2 days) of reading all twenty kathismas: who read, took or asked for help
      match /cycles/{cycleId} {
        allow read: if inGroup();
        allow create, update: if inGroup() && incoming().keys().hasOnly(['slots', 'start', 'end', 'updatedAt']);
        allow delete: if isAdmin() || leadsGroup();
      }
    }
  }
}
