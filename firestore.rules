rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reusable Helpers
    function isSignedIn() { return request.auth != null; }
    function isSuperAdmin() { return isSignedIn() && request.auth.token.email == 'mr.gabunia@gmail.com'; }
    function isAdmin() { return isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))); }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /students/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }
    
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }
    
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Classes: admins manage them; members can read the classes they belong to
    match /classes/{classId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.memberIds);
      allow write: if isAdmin();

      // Class chat: members and admins read and post as themselves; the author or an admin deletes; nothing is edited
      function inClass() {
        return isAdmin() || (isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.memberIds);
      }

      match /messages/{messageId} {
        allow read: if inClass();
        allow create: if inClass()
          && incoming().uid == request.auth.uid
          && (incoming().teacher == false || isAdmin())
          && incoming().createdAt == request.time
          && incoming().kind in ['text', 'voice']
          && incoming().text is string && incoming().text.size() <= 2000;
        allow delete: if isAdmin() || (isSignedIn() && existing().uid == request.auth.uid);
      }

      // A voice message's MP3, in parts below Firestore's 1 MiB document limit
      match /voice/{partId} {
        allow read: if inClass();
        allow create: if inClass()
          && incoming().uid == request.auth.uid
          && incoming().data is bytes && incoming().data.size() <= 750000;
        allow delete: if isAdmin() || (isSignedIn() && existing().uid == request.auth.uid);
      }
    }

    // Teacher's confirmations ("ჩათვლა") of a student's voices: the student reads, only admins write
    match /confirmations/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
  }
}
